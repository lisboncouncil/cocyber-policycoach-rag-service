# Local RAG Configuration
# Data and storage directories
DATA_DIR=./data
CHROMA_DIR=./chroma
 
# OpenAI API settings
# BASE_URL=https://api.openai.com/v1
 
# Nebius API settings
BASE_URL=https://api.studio.nebius.com/v1/
 
 
# Local RAG specific settings
# EMBED_MODEL=text-embedding-3-small
EMBED_MODEL=BAAI/bge-multilingual-gemma2
# EMBED_MODEL=mistral-embed
 
 
# Nebius chat models
# CHAT_MODEL=openai/gpt-oss-20b
# CHAT_MODEL=Qwen/Qwen3-32B-fast
CHAT_MODEL=moonshotai/Kimi-K2-Instruct
#CHAT_MODEL=moonshotai/kimi-k2-instruct-0905
 
CHUNK_TOKENS=500
COLLECTION_NAME=knowledge_base
BATCH_SIZE=512
TEMPERATURE=0.1
MAX_RESULTS=5
 
# OpenAI API key
# Nebius cocyber API key
# Nebius Lisbon council
OPENAI_API_KEY=v1... # Note: Replace with your actual API key. Do not share this key publicly.
